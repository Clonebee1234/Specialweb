# =============================================================================
# CelebrateThem — Environment variables
# =============================================================================
# Copy this file to `.env.local` for development and fill in the values.
# In production (Vercel), set these in the project's Environment Variables UI.
#
# Legend:
#   [public]  — shipped to the browser bundle. Must not contain secrets.
#   [server]  — server-only. Never imported from a Client Component.
# =============================================================================

# ---------- Runtime ----------
NODE_ENV=development
# [public] Base URL used when building shareable links in the confirmation screen.
# Use http://localhost:3000 for dev and your production domain in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Log level for the pino logger (trace | debug | info | warn | error | fatal).
LOG_LEVEL=info

# ---------- Supabase ----------
# Project URL (same on client and server).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# [public] Must equal SUPABASE_URL; duplicated because Next.js only ships env vars
# prefixed with NEXT_PUBLIC_ to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# [public] Anon key, used only for direct public-storage reads from the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...
# [server] Service role key — bypasses RLS. Used only in server route handlers.
# DO NOT commit. DO NOT import from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role...

# ---------- Admin panel ----------
# [server] Plaintext admin password fallback. Used when ADMIN_PASSWORD_HASH is unset.
ADMIN_PASSWORD=change-me-in-production
# [server] Optional scrypt hash of the admin password, produced by lib/passcode.ts.
# When set, this takes precedence over ADMIN_PASSWORD (preferred for production).
ADMIN_PASSWORD_HASH=

# ---------- Cookies ----------
# [server] 32+ byte random string used to HMAC-sign session and unlock cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SIGNING_SECRET=replace-with-48-random-bytes-base64url

# ---------- Rate limiting (Upstash Redis) ----------
# [server] Required in production. In dev, the app falls back to an in-memory
# limiter (per-process, not safe across serverless instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Admin Instagram contact ----------
# [public] Shown on the post-submission confirmation screen so creators can DM
# us to confirm their celebration and arrange payment. If unset, the UI renders
# a neutral fallback.
NEXT_PUBLIC_ADMIN_INSTAGRAM_URL=https://instagram.com/your_handle
NEXT_PUBLIC_ADMIN_INSTAGRAM_HANDLE=@your_handle
